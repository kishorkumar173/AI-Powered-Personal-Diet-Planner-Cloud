# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Authentication & Security
JWT_SECRET_KEY=super-secret-course-project-key-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloud Database Configuration
# Options: 'sqlite' (local simulated) or 'firestore' (live GCP/Firebase)
DB_BACKEND=sqlite
SQLITE_DB_PATH=./cloud_diet_planner.db
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Cloud Object Storage Configuration
# Options: 'local' (simulated bucket in ./uploads) or 'firebase' (Firebase Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# AI Recommendation Configuration
# Optional: Provide Google Gemini API Key or OpenAI API key.
# If omitted or invalid, the system automatically falls back to the rich rule-based nutrient engine!
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_FALLBACK_ENABLED=True
